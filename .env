# =============================================================
# Recipe Preparation Agent — Environment Variables
# =============================================================
# Copy this file to .env and fill in your credentials.
# Never commit .env to version control.
# =============================================================

# -------------------------
# IBM Watsonx.ai Credentials
# -------------------------
IBM_API_KEY=
IBM_PROJECT_ID=
IBM_URL=https:

# -------------------------
# IBM Granite Model
# -------------------------
MODEL_NAME=ibm/granite-3-8b-instruct

# -------------------------
# Flask Settings
# -------------------------
SECRET_KEY=your-secret-key-change-in-production
DEBUG=False
PORT=5000

# -------------------------
# Model Parameters
# -------------------------
MAX_NEW_TOKENS=1200
TEMPERATURE=0.7
TOP_P=0.9
TOP_K=50
REPETITION_PENALTY=1.1

# -------------------------
# RAG Settings
# -------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
TOP_K_RESULTS=5
FAISS_INDEX_PATH=vector_db/recipe_index.faiss
RECIPE_METADATA_PATH=vector_db/recipe_metadata.json
RECIPES_DIR=recipes/

# -------------------------
# Agent Personality (Editable)
# -------------------------
AGENT_NAME=Chef AI
AGENT_GREETING=Hello! "I'm PocketChef AI, your personal cooking assistant. Tell me what ingredients you have and I'll help you create something amazing!"
COOKING_STYLE=home-style, healthy, easy-to-follow
FOOD_PREFERENCE=balanced across all cuisines
VEGETARIAN_PREFERENCE=suggests vegetarian options when possible
CUISINE_PREFERENCE=Indian, Italian, Chinese, Mexican, Thai, American, Japanese, Mediterranean
HEALTH_GUIDELINES=Promote balanced nutrition, suggest low-oil alternatives, encourage fresh ingredients
SAFETY_RULES=Always mention allergen info, suggest safe food storage, warn about raw meat handling
FOOD_WASTE_RULES=Always suggest uses for leftover ingredients, recommend storage of unused portions
COOKING_TONE=friendly, encouraging, professional
RECIPE_DETAIL_LEVEL=detailed with clear steps, tips, and substitutions
